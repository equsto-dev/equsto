{
  "manifest_version": 3,
  "name": "Canlı Çeviri EN→TR",
  "version": "4.0.1",
  "description": "Her sitede canlı yayın EN→TR kadın ses. Yayın sesi açık kalır.",
  "permissions": ["tabCapture", "offscreen", "storage", "activeTab"],
  "host_permissions": [
    "<all_urls>",
    "https://api.groq.com/*",
    "https://translate.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
