{
  "name": "equsto-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-admin-config.mjs && next dev",
    "predev": "node scripts/generate-admin-config.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node --import ./scripts/load-env.mjs ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:verify": "node --import ./scripts/load-env.mjs scripts/verify-db.mjs",
    "admin:config": "node scripts/generate-admin-config.mjs",
    "sync:legacy": "node scripts/sync-legacy-assets.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "meilisearch": "^0.58.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
