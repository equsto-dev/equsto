# Prisma — Windows EPERM: node_modules\.prisma\client yazimini kapat
PRISMA_SKIP_POSTINSTALL_GENERATE=true

# Postgres (Supabase) — proje: gmnbhmwcmxukebulqwbn
# Kurulum: docs/SUPABASE-KURULUM.md  |  şablon: copy .env.local.template .env.local
DATABASE_URL="postgresql://postgres.gmnbhmwcmxukebulqwbn:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.gmnbhmwcmxukebulqwbn:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Meilisearch — Cloud veya yerel Docker (Hetzner gerekmez)
# Yerel: http://127.0.0.1:7700 + docker-compose.meilisearch.yml anahtarı
# Cloud: https://www.meilisearch.com/cloud → Project URL + Admin API Key
MEILISEARCH_HOST="http://127.0.0.1:7700"
MEILISEARCH_MASTER_KEY="equsto-dev-meili-key"
MEILISEARCH_INDEX="equsto_products"

# admin.html → Next API (Bearer)
EQUSTO_ADMIN_BEARER=""

# Opsiyonel: canlı statik veri köprüsü (geçiş dönemi)
LEGACY_DATA_BASE="https://equsto.com"

# TCMB EUR/TRY — GET /api/kur (mağaza canlı fiyat)
TCMB_KUR_REVALIDATE_SEC=60
EQUSTO_EUR_TRY_FALLBACK=36
# İstemci yenileme (ms): theme / eq-kur-live.js, varsayılan 600000 (10 dk)
# EQUSTO_KUR_POLL_MS=600000
