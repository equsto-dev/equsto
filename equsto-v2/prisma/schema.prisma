generator client {
  provider   = "prisma-client-js"
  output     = "./generated/client"
  /// DLL’i node_modules\.prisma\client altına kopyalamaz (Windows EPERM)
  engineType = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----- PFOS + katalog (Mayıs 2026 birleşik taslak) -----

enum Doviz {
  EUR
  TRY
  USD
}

enum MarkaTipi {
  URETICI
  ITHALAT
  OZEL_URETIM
}

/// structure.md ana hat (A–H, X); alt anlam konsept dosyasında (ör. D = pastane)
enum PfosKategoriKodu {
  A
  B
  C
  D
  E
  F
  G
  H
  X
}

enum ProductStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

model Brand {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?    @db.Text
  logoUrl     String?
  websiteUrl  String?
  markaTipi   MarkaTipi?
  notlar      String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

/// Tek katalog — storefront + PFOS aynı satış fiyatını (priceListTl) kullanır
model Product {
  id        String  @id @default(cuid())
  slug      String  @unique
  modelCode String
  sku       String? @unique
  model     String?

  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  name            String
  description     String? @db.Text
  detayliAciklama String? @db.Text
  specs           Json    @default("{}")

  ebat           String?
  elektrikGucuKw Decimal? @db.Decimal(8, 2)
  gazGucuKw      Decimal? @db.Decimal(8, 2)

  /// Kanonik satış fiyatı (TRY) — PFOS teklif + e-ticaret
  priceListTl   Decimal? @db.Decimal(12, 2)
  priceCurrency String   @default("TRY")
  /// Kaynak liste (genelde EUR) + iskonto → priceListTl (TCMB cron / import)
  fiyatListe    Decimal? @db.Decimal(12, 2)
  dovizListe    Doviz?   @default(EUR)
  bayiIskonto   Decimal? @db.Decimal(5, 4)

  stok Int @default(0)

  pfosKategoriKodu PfosKategoriKodu?
  pfosUrunTipi     String?
  pfosAltKod       String?
  ozelUretim       Boolean           @default(false)
  pfosAktif        Boolean           @default(true)
  ecommerceAktif   Boolean           @default(true)

  status ProductStatus @default(DRAFT)

  images         ProductImage[]
  pfosEslesmeler PfosUrunTipiEslesme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, modelCode])
  @@index([categoryId])
  @@index([status])
  @@index([pfosKategoriKodu])
  @@index([pfosUrunTipi])
  @@index([pfosAktif])
  @@index([ecommerceAktif])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

/// PFOS kural çıktısı (urunTipi) → katalog adayları
model PfosUrunTipiEslesme {
  id               String           @id @default(cuid())
  konseptSlug      String
  pfosUrunTipi     String
  pfosKategoriKodu PfosKategoriKodu
  pfosAltKod       String?
  productId        String
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  oncelik          Int              @default(0)
  zorunlu          Boolean          @default(false)

  @@unique([konseptSlug, pfosUrunTipi, productId])
  @@index([konseptSlug, pfosUrunTipi])
}

/// Teklif / proforma anındaki fiyat kilidi
model PfosTeklifSnapshot {
  id        String   @id @default(cuid())
  projeRef  String?
  kalemler  Json
  createdAt DateTime @default(now())

  @@index([projeRef])
  @@index([createdAt])
}

/**
 * WhatsApp / iletişim formu lead — admin «Müşteriler»
 */
model Musteri {
  id      String  @id @default(cuid())
  firma   String  @default("")
  yetkili String  @default("")
  tel     String  @default("")
  mail    String  @default("")
  sehir   String  @default("")
  tip     String  @default("lead")
  not     String? @db.Text
  kaynak  String?
  sayfa   String?
  mesaj   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tip])
  @@index([createdAt])
}
