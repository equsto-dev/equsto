# QR ile iş WhatsApp numaranızı bağlayın (authorized)
# Kaydedin; asistan: node scripts/push-whatsapp-env-hetzner.mjs .env.whatsapp.secrets

EQUSTO_WHATSAPP_MODE=green-api
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
