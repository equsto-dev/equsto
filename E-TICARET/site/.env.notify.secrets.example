# Kopyala: copy .env.notify.secrets.example .env.notify.secrets
# Sahip bildirimleri — WhatsApp modal mesajları
#   node scripts/push-notify-env-hetzner.mjs .env.notify.secrets

# Green API ile sahip WhatsApp bildirimi (90532… formatında, + yok)
WHATSAPP_NOTIFY_TO=905326840152
# Green API aynı hatta bağlıysa bildirim buraya gider (Adem Business)
WHATSAPP_NOTIFY_ALT_TO=905542378532
GREEN_API_INSTANCE_WID=905326840152
EQUSTO_WHATSAPP_E164=905326840152
EQUSTO_NOTIFY_SMS_E164=905326840152

# SMS (Twilio — opsiyonel, telefon SMS bildirimi için)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Telegram (opsiyonel yedek — telefon push)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
