# Kopyala: copy .env.notify.secrets.example .env.notify.secrets
# Sahip bildirimleri — WhatsApp modal mesajları
#   node scripts/push-notify-env-hetzner.mjs .env.notify.secrets

# Vitrin / müşteri wa.me (532)
EQUSTO_WHATSAPP_E164=905326840152
# Green API QR — 554 iş WA (532 bildirim push için)
GREEN_API_INSTANCE_WID=905542378532

# Bildirim hedefi: 532 normal hat (push). İsteğe bağlı 554 kopya:
WHATSAPP_NOTIFY_ALT_TO=
WHATSAPP_NOTIFY_TO=905326840152
EQUSTO_NOTIFY_SMS_E164=

# Telegram (önerilen — telefona anlık push, ~5 dk kurulum)
# @BotFather → /newbot → token + chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMS (Twilio — opsiyonel)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
