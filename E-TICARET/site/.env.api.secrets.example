# Equsto — tüm API / entegrasyon anahtarları (tek dosya)
# Kopyala: cp .env.api.secrets.example .env.api.secrets
# .env.api.secrets git’e GİRMEZ.
#
# Canlı Hetzner:
#   node scripts/push-api-env-hetzner.mjs .env.api.secrets
# veya GitHub Secrets + Hetzner deploy inject
#
# Parça dosyalar (.env.whatsapp.secrets vb.) hâlâ çalışır; tercih: bu tek dosya.

# —— Claude (Anthropic) ——
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# —— Google OAuth / Ads ——
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EQUSTO_GOOGLE_CLIENT_ID=
EQUSTO_GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# —— Gemini (opsiyonel) ——
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

# —— Telegram bildirim ——
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# —— E-posta (Resend) ——
RESEND_API_KEY=
RESEND_FROM=Equsto <notify@equsto.com>
RESEND_ACCOUNT_EMAIL=jurnaldang@gmail.com
EQUSTO_NOTIFY_EMAIL=jurnaldang@gmail.com

# —— WhatsApp Green API ——
EQUSTO_WHATSAPP_MODE=green-api
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
GREEN_API_WEBHOOK_TOKEN=
GREEN_API_INSTANCE_WID=905542378532
EQUSTO_WHATSAPP_E164=905326840152
WHATSAPP_NOTIFY_TO=905326840152
WHATSAPP_NOTIFY_ALT_TO=

# —— Veritabanı ——
DATABASE_URL=
DIRECT_URL=
EQUSTO_ADMIN_BEARER=

# —— TepePlatform (opsiyonel) ——
TEPEPLATFORM_ENABLED=false
TEPEPLATFORM_BASE_URL=https://tepeplatform.com
TEPEPLATFORM_API_KEY=
TEPEPLATFORM_API_SECRET=
TEPEPLATFORM_PARTNER_SLUG=equsto-endustriyel-mutfak

