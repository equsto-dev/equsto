{
  "name": "equsto-v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-admin-config.mjs && npx next dev",
    "predev": "node scripts/generate-admin-config.mjs",
    "build": "prisma generate && next build",
    "build:vercel-wrapper": "node build-from-workspace.mjs",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "postinstall": "node scripts/prisma-postinstall-skip.mjs",
    "catalog:caglayan:import": "node scripts/import-caglayan-market-reyon.mjs && node scripts/rebuild-ekipmanlar-from-dept.mjs",
    "catalog:proso:import": "node scripts/import-prosogutma-market-reyon.mjs && node scripts/rebuild-ekipmanlar-from-dept.mjs",
    "catalog:market-reyon:full": "node scripts/import-caglayan-market-reyon.mjs && node scripts/import-prosogutma-market-reyon.mjs && node scripts/rebuild-ekipmanlar-from-dept.mjs",
    "catalog:atalay:ekipmanlar": "node scripts/rebuild-ekipmanlar-from-dept.mjs",
    "search:index": "node --import ./scripts/load-env.mjs scripts/index-meilisearch.mjs",
    "admin:config": "node scripts/generate-admin-config.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/pro-components": "^2.8.10",
    "@ant-design/pro-layout": "^7.22.7",
    "@prisma/client": "^6.19.2",
    "antd": "^5.29.3",
    "exceljs": "^4.4.0",
    "meilisearch": "^0.58.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
