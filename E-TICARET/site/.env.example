# Prisma — Windows EPERM: node_modules\.prisma\client yazimini kapat
PRISMA_SKIP_POSTINSTALL_GENERATE=true

# Postgres (Supabase) — proje: lxwwbuvbaejtlqmzoykx (Frankfurt / eu-central-1)
# Kurulum: docs/SUPABASE-KURULUM.md  |  şablon: copy .env.local.template .env.local
DATABASE_URL="postgresql://postgres.lxwwbuvbaejtlqmzoykx:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.lxwwbuvbaejtlqmzoykx:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# Meilisearch — Hetzner Docker (ücretsiz) veya yerel dev
# Canlı: http://meilisearch:7700  |  Yerel: http://127.0.0.1:7700
MEILISEARCH_HOST="http://127.0.0.1:7700"
MEILISEARCH_MASTER_KEY="equsto-dev-meili-key"
MEILISEARCH_INDEX="equsto_products"

# admin.html → Next API (Bearer)
EQUSTO_ADMIN_BEARER="equsto-pro-1d4fc58e4eb081ab423cfce48163d3573288734b0cfa5353"
# Şifremi unuttum — /api/admin/forgot-password (npm run admin:bearer ile üretilir)
# EQUSTO_ADMIN_RECOVERY_CODE="eq_rc_..."
# EQUSTO_ADMIN_PW_SHA256="..."  # opsiyonel; yoksa public/data/admin-auth.json

# Opsiyonel: canlı statik veri köprüsü (geçiş dönemi)
LEGACY_DATA_BASE="https://equsto.com"

# TCMB EUR/TRY — GET /api/kur (mağaza canlı fiyat)
TCMB_KUR_REVALIDATE_SEC=60
EQUSTO_EUR_TRY_FALLBACK=36
# İstemci yenileme (ms): theme / eq-kur-live.js, varsayılan 600000 (10 dk)
# EQUSTO_KUR_POLL_MS=600000

# Faz B — AWS S3 + CloudFront (önerilen, ~20 GB medya)
# Upload (yalnızca yerel): AWS_S3_BUCKET, AWS_REGION, AWS_PROFILE
# AWS_S3_BUCKET=equsto-assets
# AWS_REGION=eu-central-1
# AWS_PROFILE=equsto
# AWS_CLOUDFRONT_URL=https://d1234abcd.cloudfront.net
# Canlı + yerel CDN test:
# NEXT_PUBLIC_ASSET_CDN_URL=https://d1234abcd.cloudfront.net
# Bkz. docs/FAZ-B-AWS.md, docs/DEPLOY-MIMARI.md

# Alternatif — Vercel Blob (küçük hacim):
# BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# NEXT_PUBLIC_GA4_ID="G-XXXXXXXX"
# NEXT_PUBLIC_GOOGLE_ADS_ID="AW-XXXXXXXXX"
# Google Ads dönüşüm etiketleri (opsiyonel, client-side):
# window.EQUSTO_ADS_CONVERSION_LABELS = { lead: "xxx", quote: "yyy", order: "zzz" }

# Anlık bildirim — kedi sohbet / yeni sipariş (en az bir kanal)
# Kurulum: docs/BILDIRIM-KURULUM.md
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
# RESEND_API_KEY=""
# Test: onboarding@resend.dev — yalnızca RESEND_ACCOUNT_EMAIL adresine gider
# Canlı: notify@equsto.com — equsto.com Resend'de doğrulanmış olmalı
# RESEND_FROM="Equsto <onboarding@resend.dev>"
# RESEND_ACCOUNT_EMAIL="jurnaldang@gmail.com"
# EQUSTO_NOTIFY_EMAIL="jurnaldang@gmail.com"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
# EQUSTO_NOTIFY_SMS_E164="905326840152"
# WhatsApp vitrin numarası (wa.me / kedi sohbet)
# EQUSTO_WHATSAPP_E164="905326840152"

# PDF import / PFOS liste yükle (Claude) — console.anthropic.com → API Keys
# Yerel: .env.local  |  Canlı: Vercel Environment Variables
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL=claude-sonnet-4-6

# WhatsApp modu — test: green-api → canlı: meta
# EQUSTO_WHATSAPP_MODE="link"       # wa.me + site içi kedi sohbet (varsayılan)
# EQUSTO_WHATSAPP_MODE="green-api"  # TEST: QR ile PDF (green-api.com)
# EQUSTO_WHATSAPP_MODE="meta"       # CANLI HEDEF: Meta Cloud API

# Green API — https://green-api.com (QR tara, Facebook yok)
# GREEN_API_INSTANCE_ID=""
# GREEN_API_TOKEN=""
# Webhook: https://equsto.com/api/whatsapp/webhook

# Meta WhatsApp Cloud API — yalnızca EQUSTO_WHATSAPP_MODE=meta iken
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""
# WHATSAPP_NOTIFY_TO="905326840152"

$env:NODE_OPTIONS="--max-old-space-size=2048"
