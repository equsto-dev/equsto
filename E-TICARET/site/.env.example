# Prisma — Windows EPERM: node_modules\.prisma\client yazimini kapat
PRISMA_SKIP_POSTINSTALL_GENERATE=true

# Postgres (Supabase) — proje: gmnbhmwcmxukebulqwbn
# Kurulum: docs/SUPABASE-KURULUM.md  |  şablon: copy .env.local.template .env.local
DATABASE_URL="postgresql://postgres.gmnbhmwcmxukebulqwbn:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.gmnbhmwcmxukebulqwbn:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Meilisearch — Cloud veya yerel Docker (Hetzner gerekmez)
# Yerel: http://127.0.0.1:7700 + docker-compose.meilisearch.yml anahtarı
# Cloud: https://www.meilisearch.com/cloud → Project URL + Admin API Key
MEILISEARCH_HOST="https://ms-f0fc0b55f378-48423.fra.meilisearch.io"
MEILISEARCH_MASTER_KEY="6b986ce9a9d88f391315eab4b1fc2d5f33bacbf4"
MEILISEARCH_INDEX="equsto_products"

# admin.html → Next API (Bearer)
EQUSTO_ADMIN_BEARER="equsto-pro-1d4fc58e4eb081ab423cfce48163d3573288734b0cfa5353"
# Şifremi unuttum — /api/admin/forgot-password (npm run admin:bearer ile üretilir)
# EQUSTO_ADMIN_RECOVERY_CODE="eq_rc_..."
# EQUSTO_ADMIN_PW_SHA256="..."  # opsiyonel; yoksa public/data/admin-auth.json

# Opsiyonel: canlı statik veri köprüsü (geçiş dönemi)
LEGACY_DATA_BASE="https://equsto.com"

# TCMB EUR/TRY — GET /api/kur (mağaza canlı fiyat)
TCMB_KUR_REVALIDATE_SEC=60
EQUSTO_EUR_TRY_FALLBACK=36
# İstemci yenileme (ms): theme / eq-kur-live.js, varsayılan 600000 (10 dk)
# EQUSTO_KUR_POLL_MS=600000

# Faz B — AWS S3 + CloudFront (önerilen, ~20 GB medya)
# Upload (yalnızca yerel): AWS_S3_BUCKET, AWS_REGION, AWS_PROFILE
# AWS_S3_BUCKET=equsto-assets
# AWS_REGION=eu-central-1
# AWS_PROFILE=equsto
# AWS_CLOUDFRONT_URL=https://d1234abcd.cloudfront.net
# Canlı + yerel CDN test:
# NEXT_PUBLIC_ASSET_CDN_URL=https://d1234abcd.cloudfront.net
# Bkz. docs/FAZ-B-AWS.md, docs/DEPLOY-MIMARI.md

# Alternatif — Vercel Blob (küçük hacim):
# BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# Anlık bildirim — kedi sohbet / yeni sipariş (en az bir kanal)
# Kurulum: docs/BILDIRIM-KURULUM.md
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
# RESEND_API_KEY=""
# EQUSTO_NOTIFY_EMAIL=""
# RESEND_FROM="Equsto <notify@equsto.com>"
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
# EQUSTO_NOTIFY_SMS_E164="905326840152"
# WhatsApp vitrin numarası (wa.me değil; yedek / API)
# EQUSTO_WHATSAPP_E164="905326840152"

$env:NODE_OPTIONS="--max-old-space-size=2048"
