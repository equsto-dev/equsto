{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "node scripts/vercel-install-clean.mjs",
  "buildCommand": "node scripts/vercel-ci.mjs",
  "rewrites": [
    { "source": "/sepet", "destination": "/sepet.html" },
    { "source": "/sepet/", "destination": "/sepet.html" },
    { "source": "/shop/market-reyonlari", "destination": "/market-reyonlari.html" },
    { "source": "/shop/market-reyonlari/", "destination": "/market-reyonlari.html" },
    { "source": "/shop/kuvetler", "destination": "/kuvetler.html" },
    { "source": "/shop/kuvetler/", "destination": "/kuvetler.html" }
  ]
}
