{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "node scripts/vercel-prebuild.mjs && node scripts/generate-admin-config.mjs && npm run build && node scripts/vercel-postbuild.mjs",
  "rewrites": [
    { "source": "/sepet", "destination": "/sepet.html" },
    { "source": "/sepet/", "destination": "/sepet.html" },
    { "source": "/shop/market-reyonlari", "destination": "/market-reyonlari.html" },
    { "source": "/shop/market-reyonlari/", "destination": "/market-reyonlari.html" },
    { "source": "/shop/kuvetler", "destination": "/kuvetler.html" },
    { "source": "/shop/kuvetler/", "destination": "/kuvetler.html" }
  ]
}
