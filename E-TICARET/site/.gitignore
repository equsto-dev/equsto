!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# Prisma client (custom output — db:generate / build üretir)
/prisma/generated/client

# Eski varsayılan client yolu (EPERM / kilit)
/node_modules/.prisma

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Eski tam katalog yedeği (~12k) — canlıda / aramada kullanılmaz
/public/data/ekipmanlar-full-archive.json
/public/data/ekipmanlar*.json
/public/data/ekipmanlar.json.backup-*
/var/catalog/ekipmanlar-full-archive.json

# Electrolux PDF/DWG/RFA (~4 GB) — kaynak: PFOS/veri/electrolux-professional/media/documents
