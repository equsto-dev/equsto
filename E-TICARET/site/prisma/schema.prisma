generator client {
  provider      = "prisma-client-js"
  /// DLL’i node_modules\.prisma\client altına kopyalamaz (Windows EPERM)
  engineType    = "library"
  /// Docker/Hetzner (node:20-bookworm) + yerel Windows
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----- PFOS + katalog (Mayıs 2026 birleşik taslak) -----

enum Doviz {
  EUR
  TRY
  USD
}

enum MarkaTipi {
  URETICI
  ITHALAT
  OZEL_URETIM
}

/// structure.md ana hat (A–H, X); alt anlam konsept dosyasında (ör. D = pastane)
enum PfosKategoriKodu {
  A
  B
  C
  D
  E
  F
  G
  H
  X
}

enum ProductStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

model Brand {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  /// Marka kodu (ör. PIMAK, OZTI) — üretici stok kodunun ön eki
  kod         String?    @unique
  description String?    @db.Text
  logoUrl     String?
  websiteUrl  String?
  markaTipi   MarkaTipi?
  notlar      String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

/// Ürün kategori ağacı: depth 0 = ürün kategori, 1–4+ = alt kategori katmanları
model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  /// 0 = ürün kategori, 1 = alt kategori 1, 2 = alt kategori 2, …
  depth     Int      @default(0)

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([parentId, depth])
}

/// Tek katalog — storefront + PFOS aynı satış fiyatını (priceListTl) kullanır
model Product {
  id        String  @id @default(cuid())
  slug      String  @unique
  modelCode String
  sku       String? @unique
  model     String?

  /// Equsto ürün kodu: EQ-{Brand.kod}.{urunKodu} (ör. EQ-PIMAK.19070.04)
  equstoKod String? @unique
  /// Üretici ürün kodu — marka öneki olmadan (ör. 19070.04)
  urunKodu  String?

  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  name            String
  /// Açıklama (kısa)
  description     String? @db.Text
  /// Detay (uzun açıklama / teknik metin)
  detayliAciklama String? @db.Text
  specs           Json    @default("{}")

  ebat           String?
  genislikMm     Int?
  derinlikMm     Int?
  yukseklikMm    Int?
  elektrikGucuKw Decimal? @db.Decimal(8, 2)
  gazGucuKw      Decimal? @db.Decimal(8, 2)

  /// Kanonik satış fiyatı (TRY) — PFOS teklif + e-ticaret
  priceListTl   Decimal? @db.Decimal(12, 2)
  priceCurrency String   @default("TRY")
  /// Liste fiyatı KDV hariç, döviz cinsinden (kaynak fiyat)
  fiyatKdvHaricDoviz Decimal? @db.Decimal(12, 2)
  dovizFiyat         Doviz?   @default(EUR)
  kdvOran            Decimal? @db.Decimal(5, 2) @default(20)
  /// Kaynak liste (genelde EUR) + iskonto → priceListTl (TCMB cron / import)
  fiyatListe    Decimal? @db.Decimal(12, 2)
  dovizListe    Doviz?   @default(EUR)
  bayiIskonto   Decimal? @db.Decimal(5, 4)

  stok Int @default(0)

  pfosKategoriKodu PfosKategoriKodu?
  pfosUrunTipi     String?
  pfosAltKod       String?
  ozelUretim       Boolean           @default(false)
  pfosAktif        Boolean           @default(true)
  ecommerceAktif   Boolean           @default(true)

  status ProductStatus @default(DRAFT)

  images         ProductImage[]
  pfosEslesmeler PfosUrunTipiEslesme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, modelCode])
  @@unique([brandId, urunKodu])
  @@index([categoryId])
  @@index([status])
  @@index([pfosKategoriKodu])
  @@index([pfosUrunTipi])
  @@index([pfosAktif])
  @@index([ecommerceAktif])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
}

/// PFOS kural çıktısı (urunTipi) → katalog adayları
model PfosUrunTipiEslesme {
  id               String           @id @default(cuid())
  konseptSlug      String
  pfosUrunTipi     String
  pfosKategoriKodu PfosKategoriKodu
  pfosAltKod       String?
  productId        String
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  oncelik          Int              @default(0)
  zorunlu          Boolean          @default(false)

  @@unique([konseptSlug, pfosUrunTipi, productId])
  @@index([konseptSlug, pfosUrunTipi])
}

/// PFOS kullanım olayı — anonim teklif üretimi + PDF gönderimi istatistiği
model PfosUsageEvent {
  id             String   @id @default(cuid())
  /// quote_generated | quote_sent
  event          String
  /// wizard | liste
  source         String   @default("")
  konsept        String   @default("")
  konseptLabel   String   @default("") @map("konsept_label")
  m2             Int?
  teklifSayi     String   @default("") @map("teklif_sayi")
  teklifRef      String   @default("") @map("teklif_ref")
  kalemSayisi    Int      @default(0) @map("kalem_sayisi")
  toplamTry      Decimal? @map("toplam_try") @db.Decimal(14, 2)
  toplamEur      Decimal? @map("toplam_eur") @db.Decimal(14, 4)
  sehir          String   @default("")
  memberLoggedIn Boolean  @default(false) @map("member_logged_in")
  memberId       String?  @map("member_id")
  gonderimKanal  String?  @map("gonderim_kanal")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([event])
  @@index([source])
  @@index([createdAt])
  @@index([teklifSayi])
  @@map("pfos_usage_event")
}

/// PFOS üye ürün gezinme — Faz C kişiselleştirme (tıklanan sayfalar)
model PfosMemberBrowseEvent {
  id           String   @id @default(cuid())
  memberId     String   @map("member_id")
  productId    String?  @map("product_id")
  slug         String
  tipKodu      String?  @map("tip_kodu")
  konseptLabel String   @default("") @map("konsept_label")
  dukkanTuru   String   @default("") @map("dukkan_turu")
  /// pdp | pfos_rail | search
  source       String   @default("pdp")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([memberId, createdAt])
  @@index([memberId, konseptLabel])
  @@index([memberId, dukkanTuru])
  @@index([memberId, slug])
  @@map("pfos_member_browse_event")
}

/// Teklif / proforma anındaki fiyat kilidi
model PfosTeklifSnapshot {
  id               String   @id @default(cuid())
  projeRef         String?
  kalemler         Json
  konsept          String?
  referansId       String?  @map("referans_id")
  referansListeKey String?  @map("referans_liste_key")
  m2               Int?
  guvenSkoru       Float?   @map("guven_skoru")
  requestJson      Json?    @map("request_json")
  createdAt        DateTime @default(now())

  feedbackEvents PfosFeedbackEvent[]

  @@index([projeRef])
  @@index([createdAt])
}

/// PFOS teklif geri bildirimi (👍/👎 + isteğe bağlı kalem düzeltmesi)
model PfosFeedbackEvent {
  id               String   @id @default(cuid())
  /// up | down
  vote             String
  /// wizard | liste | admin
  source           String   @default("wizard")
  teklifSayi       String   @default("") @map("teklif_sayi")
  snapshotId       String?  @map("snapshot_id")
  snapshot         PfosTeklifSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  konsept          String   @default("")
  konseptLabel     String   @default("") @map("konsept_label")
  referansId       String?  @map("referans_id")
  referansListeKey String?  @map("referans_liste_key")
  m2               Int?
  guvenSkoru       Float?   @map("guven_skoru")
  genelToplamEur   Decimal? @map("genel_toplam_eur") @db.Decimal(14, 4)
  yorum            String?  @db.Text
  kalemDuzeltmeleri Json?   @map("kalem_duzeltmeleri")
  memberLoggedIn   Boolean  @default(false) @map("member_logged_in")
  memberId         String?  @map("member_id")
  /// pending_review | reviewed | dismissed
  durum            String   @default("pending_review")
  reviewedAt       DateTime? @map("reviewed_at")
  reviewedBy       String?  @map("reviewed_by")
  createdAt        DateTime @default(now()) @map("created_at")

  oneriler PfosSkuLinkOneri[]

  @@index([vote])
  @@index([durum])
  @@index([teklifSayi])
  @@index([konsept])
  @@index([createdAt])
  @@map("pfos_feedback_event")
}

/// Geri bildirimden veya manuel girişten üretilen SKU link önerisi
model PfosSkuLinkOneri {
  id         String   @id @default(cuid())
  feedbackId String?  @map("feedback_id")
  feedback   PfosFeedbackEvent? @relation(fields: [feedbackId], references: [id], onDelete: SetNull)
  /// pfos-referans-sku-links anahtarı: {listeKey}|{POZ}
  linkKey    String   @map("link_key")
  listeKey   String   @map("liste_key")
  poz        String
  eskiSku    String?  @map("eski_sku")
  eskiAd     String?  @map("eski_ad") @db.Text
  yeniSku    String   @default("") @map("yeni_sku")
  yeniAd     String?  @map("yeni_ad") @db.Text
  yeniMarka  String?  @map("yeni_marka")
  /// marka_tercihi | yanlis_model | fiyat_kurali | genel …
  sorunTipi  String   @default("genel") @map("sorun_tipi")
  /// pending | approved | rejected
  durum      String   @default("pending")
  onaylayan  String?  @map("onaylayan")
  onayNotu   String?  @map("onay_notu") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([durum])
  @@index([linkKey])
  @@index([listeKey, poz])
  @@index([createdAt])
  @@map("pfos_sku_link_oneri")
}

/// Doğrulanmış referans poz → SKU (DB; JSON'un üzerine yazar)
model PfosReferansSkuLink {
  id        String   @id @default(cuid())
  linkKey   String   @unique @map("link_key")
  listeKey  String   @map("liste_key")
  poz       String
  sku       String
  name      String?  @db.Text
  marka     String?
  /// feedback | manual | import_json | script
  kaynak    String   @default("feedback")
  oneriId   String?  @map("oneri_id")
  onaylayan String?  @map("onaylayan")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([listeKey])
  @@map("pfos_referans_sku_link")
}

/// PFOS fiyat türetme kuralı (ürün doğru, fiyat formülü özel)
model PfosFiyatKurali {
  id            String   @id @default(cuid())
  /// global | konsept | liste_key
  kapsam        String   @default("global")
  konseptSlug   String?  @map("konsept_slug")
  listeKey      String?  @map("liste_key")
  poz           String?
  urunTipi      String?  @map("urun_tipi")
  isimKalibi    String?  @map("isim_kalibi")
  /// carp | sabit_sku | sabit_fiyat_eur
  kuralTipi     String   @map("kural_tipi")
  carpan        Float?
  bazSku        String?  @map("baz_sku")
  sabitFiyatEur Decimal? @map("sabit_fiyat_eur") @db.Decimal(14, 4)
  aciklama      String?  @db.Text
  kaynak        String   @default("feedback")
  onaylayan     String?  @map("onaylayan")
  aktif         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([kapsam, konseptSlug])
  @@index([listeKey, poz])
  @@index([urunTipi])
  @@index([aktif])
  @@map("pfos_fiyat_kurali")
}

/**
 * WhatsApp / iletişim formu lead — admin «Müşteriler»
 */
model Musteri {
  id      String  @id @default(cuid())
  firma   String  @default("")
  yetkili String  @default("")
  tel     String  @default("")
  mail    String  @default("")
  sehir   String  @default("")
  tip     String  @default("lead")
  not     String? @db.Text
  kaynak  String?
  sayfa   String?
  mesaj   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tip])
  @@index([createdAt])
}

/// Vitrin sepeti — cihazlar arası (guest UUID veya üye e-postası)
model ShopCart {
  cartKey   String   @id
  items     Json     @default("[]")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([updatedAt])
}

/// 6 haneli eşitleme kodu → cartKey (15 dk)
model ShopCartLinkCode {
  code      String   @id @db.VarChar(8)
  cartKey   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([cartKey])
}

/// Vitrin üye girişi (e-posta / Google)
model ShopMember {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String   @default("")
  telefon      String   @default("")
  teslimatAdres Json    @default("{}")
  provider     String   @default("email")
  picture      String?
  cartItems    Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions       ShopMemberSession[]
  passwordResets ShopMemberPasswordReset[]
}

model ShopMemberPasswordReset {
  id        String    @id @default(cuid())
  memberId  String
  member    ShopMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([memberId])
  @@index([expiresAt])
}

model ShopMemberSession {
  token     String     @id
  memberId  String
  member    ShopMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([memberId])
  @@index([expiresAt])
}

enum SiparisDurum {
  beklemede
  hazirlaniyor
  kargoda
  teslim
  iptal
}

/// Kart ödemesi — lojistik `SiparisDurum` ile ayrı tutulur
enum OdemeDurum {
  yok
  bekliyor
  provizyon
  tahsil
  iptal
  basarisiz
  iade
}

enum TeklifDurum {
  taslak
  gonderildi
  onaylandi
  reddedildi
  revize
  iptal
}

/// Vitrin sepetinden gelen sipariş (havale talebi veya TepePlatform kart ödemesi)
model Siparis {
  id                   String       @id @default(cuid())
  siparisNo            String       @unique @map("siparis_no")
  musteriAd            String       @default("") @map("musteri_ad")
  musteriTel           String       @default("") @map("musteri_tel")
  musteriMail          String       @default("") @map("musteri_mail")
  not                  String?      @db.Text
  kalemler             Json         @default("[]")
  toplamKalem          Int          @default(0) @map("toplam_kalem")
  toplamAdet           Int          @default(0) @map("toplam_adet")
  toplamTl             Decimal      @default(0) @map("toplam_tl") @db.Decimal(14, 2)
  durum                SiparisDurum @default(beklemede)
  kaynak               String?
  kuponKod             String?      @map("kupon_kod")
  indirimTl            Decimal?     @map("indirim_tl") @db.Decimal(12, 2)
  musteriId            String?      @map("musteri_id")
  payload              Json?
  odemeDurum           OdemeDurum   @default(yok) @map("odeme_durum")
  odemeGateway         String?      @map("odeme_gateway")
  odemePaymentId       String?      @map("odeme_payment_id")
  odemeConversationId  String?      @map("odeme_conversation_id")
  odemeToken           String?      @map("odeme_token")
  odemePaidTl          Decimal?     @map("odeme_paid_tl") @db.Decimal(14, 2)
  odemePayload         Json?        @map("odeme_payload")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  @@index([durum])
  @@index([odemeDurum])
  @@index([createdAt])
  @@index([musteriId])
  @@index([odemePaymentId])
  @@map("siparis")
}

/// PFOS / admin teklif kaydı
model Teklif {
  id              String      @id @default(cuid())
  refNo           String      @unique @map("ref_no")
  musteriAd       String      @default("") @map("musteri_ad")
  musteriTel      String      @default("") @map("musteri_tel")
  musteriMail     String      @default("") @map("musteri_mail")
  konsept         String      @default("")
  toplamTl        Decimal     @default(0) @map("toplam_tl") @db.Decimal(14, 2)
  gecerlilikBitis DateTime?   @map("gecerlilik_bitis")
  durum           TeklifDurum @default(gonderildi)
  not             String?     @map("not_") @db.Text
  kalemler        Json?
  kaynak          String?
  payload         Json?
  musteriId       String?     @map("musteri_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@index([durum])
  @@index([createdAt])
  @@index([musteriId])
  @@map("teklif")
}

/// Meilisearch / vitrin arama sorguları (rapor)
model SearchQueryLog {
  id        String   @id @default(cuid())
  query     String
  hitCount  Int      @default(0) @map("hit_count")
  source    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([query])
  @@map("search_query_log")
}

/// Ürün sayfası süre takibi (anonim + üye)
model ProductPageView {
  id         String   @id @default(cuid())
  sessionId  String   @map("session_id")
  path       String
  productId  String?  @map("product_id")
  slug       String
  dept       String   @default("")
  title      String   @default("")
  brand      String   @default("")
  durationMs Int      @map("duration_ms")
  locale     String   @default("tr")
  memberId   String?  @map("member_id")
  referrer   String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([slug, createdAt])
  @@index([productId, createdAt])
  @@index([sessionId, createdAt])
  @@index([dept, createdAt])
  @@map("product_page_view")
}

/// Mr. Equsto WhatsApp modal — üye telefonu ile eşleşen sohbet satırları
model WaChatMessage {
  id          String   @id @default(cuid())
  phone       String
  role        String
  body        String   @db.Text
  waMessageId String?  @unique @map("wa_message_id")
  memberId    String?  @map("member_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("wa_chat_message")
}
