# Caddy — equsto.com reverse proxy (otomatik HTTPS)
# Ortam: ACME_EMAIL=admin@equsto.com  (docker-compose .env veya sunucu env)

{
	email {$ACME_EMAIL:admin@equsto.com}
}

# DNS kesimi öncesi — yalnızca http://167.233.86.144 (https://IP çalışmaz)
http://167.233.86.144 {
	encode gzip zstd
	reverse_proxy app:3000
}

# DNS kesimi öncesi — hosts dosyası testi (https henüz sertifika alamaz)
http://equsto.com, http://www.equsto.com {
	encode gzip zstd
	handle /api/proje-akis* {
		rewrite * /api/cms?kind=proje-akis
		reverse_proxy app:3000
	}
	handle /api/pfos/* {
		reverse_proxy app:3000 {
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}
	handle {
		reverse_proxy app:3000
	}
}

equsto.com {
	encode gzip zstd
	handle /api/proje-akis* {
		rewrite * /api/cms?kind=proje-akis
		reverse_proxy app:3000
	}
	handle /api/pfos/* {
		reverse_proxy app:3000 {
			transport http {
				read_timeout 5m
				write_timeout 5m
			}
		}
	}
	handle {
		reverse_proxy app:3000
	}
}

www.equsto.com {
	redir https://equsto.com{uri} permanent
}
